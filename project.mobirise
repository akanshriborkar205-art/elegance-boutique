              "margin-bottom": "2rem",
              "@media (max-width: 767px)": {
                "margin-bottom": "2rem",
                "padding": "0rem 0rem 0.5rem"
              },
              "padding": "0rem 0rem 2rem",
              "@media (max-width: 991px)": {
                "padding": "0rem 0rem 0.5rem"
              }
            },
            ".mbr-section-subtitle, .main-button .btn": {
